@startuml Arquitetura Azure Completa
!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

title Arquitetura Completa - Sistema NPS Surveys no Azure

package "Internet" {
  [Usuários/Convidados] as Users
  [Admin] as Admin
}

package "Azure Cloud" {
  
  package "Networking" {
    component [Azure DNS\nseudominio.com\nRegistros A, CNAME, MX] as DNS #LightBlue
    component [Azure CDN\nArquivos Estáticos] as CDN #LightBlue
  }
  
  package "Application Layer" {
    component [Azure App Service\nDjango Backend\n- Web App\n- Admin Panel\n- API REST] as Django #0078D4
    component [Azure App Service\nFastAPI Service\n- REST API\n- Analytics] as FastAPI #0078D4
  }
  
  package "Data Layer" {
    database [Azure Database\nfor PostgreSQL\n- Surveys\n- Responses\n- Invitations] as DB #336791
    storage [Azure Storage\n- Static Files\n- Logs\n- Backups] as Storage #0078D4
  }
  
  package "Communication" {
    component [Azure Communication\nServices Email\nou SendGrid\n- Envio de Convites\n- Tracking] as EmailService #1A82E2
  }
  
  package "Security & Monitoring" {
    component [Azure Key Vault\nSecrets & Credentials] as KeyVault #FF6600
    component [Application Insights\nMonitoring & Logs] as Monitor #0078D4
  }
}

package "External Services (Opcional)" {
  component [Microsoft 365\nEmail Corporativo] as Office365 #0078D4
}

' Conexões
Users -->|HTTPS| DNS
Admin -->|HTTPS| DNS
DNS -->|Route| Django
DNS -->|Route| FastAPI
Django -->|Query| DB
FastAPI -->|Query| DB
Django -->|Send Emails| EmailService
Django -->|Store Files| Storage
Django -->|Read Secrets| KeyVault
Django -->|Logs| Monitor
FastAPI -->|Logs| Monitor
CDN -->|Serve| Storage
EmailService -->|Deliver| Users
EmailService ..>|Optional| Office365

note right of EmailService
  SendGrid ou Azure Communication
  Services Email para envio
  transacional de convites
end note

note right of DNS
  Azure DNS gerencia todo
  o domínio e DNS.
  Não precisa HostGator!
end note

@enduml

